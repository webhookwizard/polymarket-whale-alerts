# Copy to .env and adjust. The demo (python3 demo.py) needs NOTHING here —
# it runs fully offline in mock/paper mode.
#
# ── Watcher ──────────────────────────────────────────────────────────────
# Seconds between trade-feed polls.
POLL_INTERVAL_SEC=15
# Default whale threshold: alert on single trades >= this USD value.
DEFAULT_MIN_USD=10000
# Default probability filter (trade price must be inside this range).
DEFAULT_PROB_MIN=0.05
DEFAULT_PROB_MAX=0.95

# ── Telegram (optional — bot stays fully testable without it) ─────────────
# Get a token from @BotFather. Alerts go to TG_DEFAULT_CHAT_ID.
TG_BOT_TOKEN=
TG_DEFAULT_CHAT_ID=

# ── Web dashboard ────────────────────────────────────────────────────────
WEB_HOST=127.0.0.1
WEB_PORT=5000
DB_PATH=whale_alerts.db

# ── LIVE TRADING (real money — ALL of the below must be true to enable) ───
# 1. This flag must be literally "true". Default is paper mode.
POLY_LIVE_TRADING=false
# 2. Polygon (chain 137) private key of the wallet that holds your USDC.
#    NEVER commit this file. NEVER paste the key into chat, logs, or issues.
POLY_PRIVATE_KEY=
# 3. Safety cap: any single order above this USD value is REJECTED before
#    signing. Start tiny (e.g. 5–25). There is no way to bypass the cap
#    from the bot or dashboard — it lives in code, not in the UI.
POLY_MAX_ORDER_USD=25
# Optional: override for proxy/email wallets (defaults to the signer's wallet).
# POLY_WALLET=
